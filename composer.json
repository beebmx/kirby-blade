{
    "name": "beebmx/kirby-blade",
    "description": "Blade template for Kirby",
    "keywords": [
        "blade",
        "view",
        "template",
        "kirby",
        "kirby-plugin",
        "kirby3",
        "kirby4",
        "kirby5",
        "kirby6"
    ],
    "version": "7.0.0",
    "type": "kirby-plugin",
    "license": "MIT",
    "homepage": "https://github.com/beebmx/kirby-blade",
    "authors": [
        {
            "name": "Fernando Gutierrez",
            "homepage": "https://beeb.mx"
        }
    ],
    "require": {
        "php": "^8.4",
        "beebmx/blade": "^1.10",
        "getkirby/composer-installer": "^1.2",
        "illuminate/view": "^12.0|^13.0",
        "ramsey/uuid": "^4.7"
    },
    "conflict": {
        "getkirby/cms": "<4.0"
    },
    "require-dev": {
        "getkirby/cli": "^1.7|^2.1",
        "getkirby/cms": "^4.0|^5.0|^6.0",
        "laravel/pint": "^1.0",
        "pestphp/pest": "^5.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "getkirby/composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "files": [
            "helpers.php"
        ],
        "psr-4": {
            "Beebmx\\KirbyBlade\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/Fixtures/app/",
            "Beebmx\\KirbyBlade\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php -d auto_prepend_file=tests/constants.php vendor/bin/pest"
    },
    "extra": {
        "kirby": {
            "compatible": "^3.0 || ^4.0 || ^5.0 || ^6.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
